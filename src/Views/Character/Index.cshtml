@model WarHack.Models.CharacterView
@{
    ViewData["Title"] = Model is null ? "Character Lookup" : $"{Model.Name} - {Model.Realm}";
}

@functions {
    static string QualityClass(string quality) => quality switch
    {
        "Legendary" => "text-warning",
        "Epic"      => "text-purple",
        "Rare"      => "text-primary",
        "Uncommon"  => "text-success",
        _           => "text-body"
    };
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-sm-4">
        <label for="realm" class="form-label">Realm</label>
        <input id="realm" name="realm" class="form-control" value="@ViewData["Realm"]"
               placeholder="Tichondrius" required />
    </div>
    <div class="col-sm-4">
        <label for="name" class="form-label">Character</label>
        <input id="name" name="name" class="form-control" value="@ViewData["Name"]"
               placeholder="Gav" required />
    </div>
    <div class="col-sm-2">
        <button type="submit" class="btn btn-primary w-100">Look up</button>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="alert alert-warning py-2" role="alert"></div>

@if (Model is not null)
{
    <div class="d-flex flex-wrap align-items-baseline gap-2 mb-1">
        <h2 class="mb-0">@Model.Name</h2>
        <span class="text-muted">@Model.Realm</span>
    </div>
    <p class="text-muted mb-3">
        Level @Model.Level @Model.Race @Model.Spec @Model.Class
        @if (!string.IsNullOrWhiteSpace(Model.Guild))
        {
            <span>&middot; &lt;@Model.Guild&gt;</span>
        }
        &middot; @Model.Faction
    </p>

    <div class="row g-3 mb-4">
        <div class="col-sm-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Equipped iLvl</div>
                <div class="fs-4">@Model.EquippedItemLevel.ToString("0.#")</div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Average iLvl</div>
                <div class="fs-4">@Model.AverageItemLevel.ToString("0.#")</div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Achievements</div>
                <div class="fs-4">@Model.AchievementPoints.ToString("N0")</div>
            </div>
        </div>
        <div class="col-sm-3">
            <div class="border rounded p-3 h-100">
                <div class="text-muted small">Last seen</div>
                <div class="fs-6 pt-2">
                    @(Model.LastLogin is null ? "—" : Model.LastLogin.Value.ToLocalTime().ToString("d MMM yyyy"))
                </div>
            </div>
        </div>
    </div>

    @if (Model.MissingEnchants.Count > 0 || Model.EmptySockets.Count > 0)
    {
        <div class="alert alert-warning py-2 mb-4">
            @if (Model.MissingEnchants.Count > 0)
            {
                <div><strong>Unenchanted:</strong> @string.Join(", ", Model.MissingEnchants)</div>
            }
            @if (Model.EmptySockets.Count > 0)
            {
                <div><strong>Empty sockets:</strong> @string.Join(", ", Model.EmptySockets)</div>
            }
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <h5>Stats</h5>
            @if (Model.Stats.Count == 0)
            {
                <p class="text-muted">Statistics unavailable.</p>
            }
            else
            {
                <table class="table table-sm">
                    <tbody>
                    @foreach (var stat in Model.Stats)
                    {
                        <tr>
                            <th scope="row" class="fw-normal text-muted">@stat.Label</th>
                            <td class="text-end">@stat.Value</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="col-lg-8">
            <h5>Gear</h5>
            @if (Model.Gear.Count == 0)
            {
                <p class="text-muted">Equipment unavailable.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Slot</th>
                                <th>Item</th>
                                <th class="text-end">iLvl</th>
                                <th>Enchants &amp; gems</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Gear)
                        {
                            <tr>
                                <td class="text-muted">@item.Slot</td>
                                <td class="@QualityClass(item.Quality)">@item.ItemName</td>
                                <td class="text-end">@item.ItemLevel</td>
                                <td class="small">
                                    @foreach (var enchant in item.Enchants)
                                    {
                                        <div>@enchant</div>
                                    }
                                    @foreach (var gem in item.Gems)
                                    {
                                        <div class="text-muted">@gem</div>
                                    }
                                    @if (item.EmptySocketCount > 0)
                                    {
                                        <div class="text-danger">
                                            @item.EmptySocketCount empty socket@(item.EmptySocketCount > 1 ? "s" : "")
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@model WarHack.Models.LogsPageView
@{
    ViewData["Title"] = "Logs";
}

@functions {
    static string LevelClass(string level) => level switch
    {
        "Error"       => "text-danger",
        "Warning"     => "text-warning-emphasis",
        "Information" => "text-body",
        _             => "text-muted"
    };
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h2 class="mb-0">Logs</h2>
    <div class="btn-group btn-group-sm">
        <a class="btn @(Model.Level is null ? "btn-primary" : "btn-outline-secondary")"
           asp-action="Index">All</a>
        @foreach (var level in Model.Levels)
        {
            <a class="btn @(Model.Level == level.Level ? "btn-primary" : "btn-outline-secondary")"
               asp-action="Index" asp-route-level="@level.Level">
                @level.Level <span class="opacity-75">@level.Count</span>
            </a>
        }
    </div>
</div>

@if (Model.TotalRows == 0)
{
    <p class="text-muted">Nothing shipped yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width: 12rem;">When</th>
                    <th style="width: 7rem;">Level</th>
                    <th style="width: 12rem;">Logger</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    <td class="text-muted small">@row.DateAdded.ToLocalTime().ToString("dd MMM HH:mm:ss")</td>
                    <td class="@LevelClass(row.Level)">@row.Level</td>
                    <td class="text-muted small">@row.Logger</td>
                    <td class="small">@row.Message</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <span class="text-muted small">
            @Model.FirstRowOnPage–@Model.LastRowOnPage of @Model.TotalRows.ToString("N0")
        </span>

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Log pages">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-level="@Model.Level" asp-route-page="1"
                           aria-label="First">&laquo;</a>
                    </li>
                    <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-level="@Model.Level" asp-route-page="@(Model.Page - 1)">Previous</a>
                    </li>

                    <li class="page-item disabled">
                        <span class="page-link">Page @Model.Page of @Model.TotalPages</span>
                    </li>

                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-level="@Model.Level" asp-route-page="@(Model.Page + 1)">Next</a>
                    </li>
                    <li class="page-item @(Model.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-level="@Model.Level" asp-route-page="@Model.TotalPages"
                           aria-label="Last">&raquo;</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}

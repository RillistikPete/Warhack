{
  "AppConfigOptions": {
    "SwaggerPath": "/swagger/v1"
  },
  "Blizzard": {
    "BaseUrl": "https://us.api.blizzard.com/",
    "TokenUrl": "https://oauth.battle.net/token",
    "Namespace": "profile-us",
    "Locale": "en_US"
  },
  "ConnectionStrings": {
    "WarHackDb": ""
  },
  "LogRetention": {
    "Enabled": true,
    "Retention": "30.00:00:00",
    "Interval": "12:00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
